{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daidar-attendance-push",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daidar-admin",
      "database_id": "4f962096-a4cb-4bc3-8da6-3efaf80f8c6f"
    }
  ],
  "vars": {
    "VAPID_SUBJECT": "mailto:admin@daidarsoluations.com"
  }
}
