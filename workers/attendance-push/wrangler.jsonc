{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daidar-attendance-push",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daidar-admin",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "REPLACE_WITH_GENERATED_PUBLIC_KEY",
    "VAPID_SUBJECT": "mailto:admin@daidarsoluations.com"
  }
}
