# Daidar Solutions - متغيرات البيئة المطلوبة

# مفتاح Resend API - احصل عليه من https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# عنوان البريد الإلكتروني للمرسل (يجب توثيق النطاق في Resend أولاً)
# مثال: noreply@daidarsolutions.com
RESEND_FROM_EMAIL=noreply@yourdomain.com

# البريد الإلكتروني الذي يستقبل الطلبات
RESEND_TO_EMAIL=khaleddaidar2@gmail.com

# عنوان الموقع (يُستخدم في sitemap.xml وbots)
NEXT_PUBLIC_SITE_URL=https://daidarsolutions.com

# رابط منصة متجري (منصة المتاجر السحابية)
NEXT_PUBLIC_MATJARI_URL=http://localhost:5173/daidarsoluations/ar/new_test_store/

# Cloudflare Pages secrets (server only; do not use NEXT_PUBLIC_)
ADMIN_EMAIL=admin@yourdomain.com
# Generate with: node scripts/admin-password.cjs
ADMIN_PASSWORD_HASH=
# Bind a Cloudflare D1 database as DB and apply migrations/0001_admin.sql.
